{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acm_individus.schema.json",
  "title": "Tableau croisé pondéré du recensement pour la méthode acm_individus (data/acm_individus.json)",
  "type": "object",
  "required": [
    "description",
    "reference_year",
    "field",
    "sources",
    "weights_column",
    "variables",
    "ages",
    "row_format",
    "rows",
    "age_rows"
  ],
  "properties": {
    "description": { "type": "string" },
    "reference_year": { "type": "integer" },
    "field": { "type": "string", "description": "Personnes retenues" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "source.schema.json" } },
    "weights_column": { "type": "string" },
    "variables": {
      "type": "object",
      "description": "Variables actives de l'ACM, dans l'ordre des colonnes de rows",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "columns", "modalities"],
        "properties": {
          "label": { "type": "string" },
          "columns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "modalities": { "type": "array", "items": { "type": "string" }, "minItems": 2 }
        }
      }
    },
    "ages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "row_format": { "type": "array", "items": { "type": "string" } },
    "rows": { "$ref": "#/$defs/rows", "description": "Groupe : code PCS. Emploi nul : retraité, hors du calcul des axes." },
    "age_rows": { "$ref": "#/$defs/rows", "description": "Groupe : classe d'âge, individus actifs de l'ACM seulement." }
  },
  "$defs": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "string" },
          { "type": "integer", "minimum": 0 },
          { "type": "integer", "minimum": 0 },
          { "type": ["integer", "null"], "minimum": 0 },
          { "type": "integer", "exclusiveMinimum": 0 }
        ],
        "minItems": 5,
        "maxItems": 5
      }
    }
  }
}
